# Copy to .env.local and adjust. No variable is required for local development.

# Public URL of the deployment. Used to build absolute URLs in page metadata
# (Open Graph). Leave empty to omit.
NEXT_PUBLIC_SITE_URL=

# Path to the scraped dataset, absolute or relative to the working directory.
# Defaults to data/all_papers.json.
PAPERS_DATA_FILE=

# Port for `npm start` / the Docker image (Next.js reads PORT).
PORT=3000
